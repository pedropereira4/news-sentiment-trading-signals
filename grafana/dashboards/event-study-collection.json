  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Small-cap signals (stopping rule)",
      "description": "Eligible small-cap signals since 2026-09-28. The study stops at 300 or on 2026-10-30, whichever comes first.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) AS \"Small-cap signals\"\nFROM v_signals\nWHERE cap_group = 'small_mid_cap' AND published_at >= TIMESTAMPTZ '2026-09-28 00:00 America/New_York' AND NOT (source <> 'finnhub') AND NOT (NOT feed_timestamp) AND NOT (llm_model <> 'google/gemini-3.1-flash-lite') AND NOT (cap_group IS NULL)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 300,
          "color": {
            "mode": "fixed",
            "fixedColor": "#9085e9"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "orientation": "horizontal",
