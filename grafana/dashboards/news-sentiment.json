{
  "uid": "news-sentiment",
  "title": "Real-time News Sentiment",
  "tags": [
    "kafka",
    "llm",
    "sentiment"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Source",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"source\",\n  predicate: (r) => r._measurement == \"article_sentiment\", start: -30d)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Articles analysed",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"article_sentiment\")\n  |> filter(fn: (r) => r.source =~ /^${source:regex}$/)\n  |> filter(fn: (r) => r._field == \"score\")\n  |> group()\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Average sentiment",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"article_sentiment\")\n  |> filter(fn: (r) => r.source =~ /^${source:regex}$/)\n  |> filter(fn: (r) => r._field == \"score\")\n  |> group()\n  |> mean()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "min": -1,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": -0.55
              },
              {
                "color": "blue",
                "value": -0.25
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Negative share",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"article_sentiment\")\n  |> filter(fn: (r) => r.source =~ /^${source:regex}$/)\n  |> filter(fn: (r) => r._field == \"score\")\n  |> group()\n  |> map(fn: (r) => ({r with neg: if r.sentiment == \"negative\" then 1.0 else 0.0}))\n  |> mean(column: \"neg\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.55
              },
              {
                "color": "red",
                "value": 0.75
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "LLM latency per headline",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"article_sentiment\")\n  |> filter(fn: (r) => r.source =~ /^${source:regex}$/)\n  |> filter(fn: (r) => r._field == \"llm_latency_ms\")\n  |> group()\n  |> mean()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Sentiment trend by source (30m mean)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"article_sentiment\")\n  |> filter(fn: (r) => r.source =~ /^${source:regex}$/)\n  |> filter(fn: (r) => r._field == \"score\")\n  |> group(columns: [\"source\"])\n  |> aggregateWindow(every: 30m, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": -1,
          "max": 1,
          "decimals": 2,
          "displayName": "${__field.labels.source}",
          "custom": {
            "lineInterpolation": "smooth",
            "spanNulls": true,
            "showPoints": "always",
            "pointSize": 4
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Sentiment distribution",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"article_sentiment\")\n  |> filter(fn: (r) => r.source =~ /^${source:regex}$/)\n  |> filter(fn: (r) => r._field == \"score\")\n  |> group(columns: [\"sentiment\"])\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*positive.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "displayName",
                "value": "positive"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*neutral.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "displayName",
                "value": "neutral"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*negative.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "displayName",
                "value": "negative"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Headline volume by sentiment (1h)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"article_sentiment\")\n  |> filter(fn: (r) => r.source =~ /^${source:regex}$/)\n  |> filter(fn: (r) => r._field == \"score\")\n  |> group(columns: [\"sentiment\"])\n  |> aggregateWindow(every: 1h, fn: count, createEmpty: true)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*positive.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "displayName",
                "value": "positive"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*neutral.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "displayName",
                "value": "neutral"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*negative.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "displayName",
                "value": "negative"
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Top topics",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"topic_mention\")\n  |> filter(fn: (r) => r.source =~ /^${source:regex}$/)\n  |> filter(fn: (r) => r._field == \"count\")\n  |> group(columns: [\"topic\"])\n  |> sum()\n  |> group()\n  |> sort(columns: [\"_value\"], desc: true)\n  |> limit(n: 12)\n  |> rename(columns: {_value: \"mentions\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "topic",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Topic sentiment (min. 2 mentions)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"topic_mention\")\n  |> filter(fn: (r) => r.source =~ /^${source:regex}$/)\n  |> filter(fn: (r) => r._field == \"score\")\n  |> group(columns: [\"topic\"])\n  |> reduce(\n      identity: {total: 0.0, mentions: 0},\n      fn: (r, accumulator) => ({total: accumulator.total + r._value,\n                                 mentions: accumulator.mentions + 1}))\n  |> map(fn: (r) => ({topic: r.topic, mentions: r.mentions,\n                      avg_score: r.total / float(v: r.mentions)}))\n  |> group()\n  |> filter(fn: (r) => r.mentions >= 2)\n  |> sort(columns: [\"avg_score\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "topic"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mentions"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "avg_score"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "min",
                "value": -1
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-RdYlGr"
                }
              }
            ]
          }
        ]
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "topic": 0,
              "mentions": 1,
              "avg_score": 2
            }
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Latest headlines",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"article_sentiment\")\n  |> filter(fn: (r) => r.source =~ /^${source:regex}$/)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"_time\", \"source\", \"sentiment\", \"score\", \"title\", \"topics\", \"url\"])\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 100)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "score"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-RdYlGr"
                }
              },
              {
                "id": "min",
                "value": -1
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "title"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open article",
                    "url": "${__data.fields.url}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
