# Copy to .env and fill in:  cp .env.example .env

# ---------- LLM ----------
# ollama     -> a model running locally (free, offline, no API key)
# openrouter -> any hosted model via OpenRouter (needs OPENROUTER_API_KEY)
# anthropic  -> Anthropic API directly (needs ANTHROPIC_API_KEY)
# mock       -> keyword lexicon, no network: used by the tests and for a zero-setup demo
LLM_PROVIDER=mock

# ollama:     llama3.2:3b | qwen2.5:3b | any tag you have pulled (`ollama list`)
# openrouter: e.g. google/gemini-2.5-flash-lite  (check the current catalogue)
LLM_MODEL=llama3.2:3b

# Where Ollama listens. From inside a container use host.docker.internal;
# running the service on the host use http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
LLM_TEMPERATURE=0
# Local models are slower than hosted ones — 120s is a safe ceiling for Ollama
LLM_TIMEOUT_SECONDS=120

# Enricher micro-batching: one LLM call per batch of headlines.
# Hosted models cope with 10; for a small local model 5 is more reliable.
ENRICHER_BATCH_SIZE=5
ENRICHER_BATCH_TIMEOUT_SECONDS=5

# ---------- Producer ----------
FEEDS_FILE=/app/config/feeds.yaml
POLL_INTERVAL_SECONDS=120

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
TOPIC_RAW=news.raw
TOPIC_ENRICHED=news.enriched
TOPIC_DLQ=news.dlq

# ---------- InfluxDB ----------
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=sentiment
INFLUXDB_BUCKET=news_sentiment
INFLUXDB_TOKEN=change-me-super-secret-token
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-please

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

LOG_LEVEL=INFO
